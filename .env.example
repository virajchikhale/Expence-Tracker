# Copy to .env (never commit it) and fill in. Read by docker compose.
# openssl rand -hex 32
JWT_SECRET=
# URL-safe characters only (letters and digits)
MONGO_PASSWORD=
# MONGO_USER=expense
# MongoDB 5+ needs a CPU with AVX; on older hardware use MONGO_IMAGE=mongo:4.4
# MONGO_IMAGE=mongo:7
# MongoDB 5+ needs a CPU with AVX; on older hardware use MONGO_IMAGE=mongo:4.4
# MONGO_IMAGE=mongo:7
# Use MongoDB Atlas instead of the bundled MongoDB:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Where the browser reaches the API / which origin the API accepts (change both when you deploy behind a domain)
# PUBLIC_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000
# ENVIRONMENT=production
