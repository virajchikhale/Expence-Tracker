# Copy to .env (never commit it). Used by docker compose from the repo root and for local runs.
# production (default) refuses to start without a strong JWT_SECRET and a real CORS_ORIGINS; dev relaxes that and exposes /docs
ENVIRONMENT=production
# openssl rand -hex 32
JWT_SECRET=
# Local Docker: leave the compose default. Atlas: mongodb+srv://user:pass@cluster/...
# MONGO_URI=
CORS_ORIGINS=http://localhost:3000
DB_NAME=expense_tracker_db
ACCESS_TOKEN_EXPIRE_MINUTES=480
# ENABLE_DOCS=true
